transcripts/_audio/
models/*.bin
tools/
*.wav
.DS_Store
__pycache__/
.venv/
.env
# Raw ingest caches are committed so a fresh clone sees the same Simple tab:
# expectations (radar inputs), research packs (print-qual inputs) and the dive
# run caches (the coverage reports' dive links). The bulky web caches stay out.
data/raw/*
!data/raw/expectations
!data/raw/research
!data/raw/deepsearch
data/raw/deepsearch/*
!data/raw/deepsearch/runs
data/curated/
data/llm_logs/
# Idea reports: the simple process's and the Setups tab's reports are part of
# the deliverable.
ideas/*
!ideas/simple
!ideas/setups
*.pyc
.pytest_cache/
*.mp4
*.xls
*.xlsx
*.xlsm
*.pdf